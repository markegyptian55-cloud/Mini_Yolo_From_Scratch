# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual Environments
venv/
env/
.venv/
.env/

# Dataset images/labels (large, not source-controlled). Provenance and stats ARE
# tracked: dataset/data.yaml, dataset/DATASET_REPORT.md, dataset/metadata/**/*.csv,
# dataset/metadata/**/*.json, dataset/metadata/**/*.md are NOT ignored below.
dataset/images/
dataset/labels/
dataset/VIDEO FOR TEST/
dataset/metadata/lineage/EDA/

# Checkpoints: weights and rendered demo videos are large binaries and are
# regenerated by training/export/report, so they are not source-controlled. The
# reports themselves (evaluation.txt, training_log.csv, training_summary.txt,
# args.yaml, hyp.yaml, plots/*.png, demo_video/analysis.txt) ARE tracked.
checkpoints/**/weights/
checkpoints/**/demo_video/*.mp4
*.pt
*.pth
*.onnx
*.engine

# Legacy path, kept as a safety net in case something still writes here
runs/

# IDE configurations
.vscode/
.idea/
.project
.pydevproject

# System files
.DS_Store
Thumbs.db
desktop.ini

